name = "daiso-shms-attachments"
main = "src/index.js"
compatibility_date = "2026-08-13"

[[r2_buckets]]
binding = "SHMS_FILES"
bucket_name = "daiso-shms-files"

[vars]
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "sb_publishable_YOUR_PUBLIC_KEY"
APP_ORIGIN = "https://sky5224122-jpg.github.io"
MAX_FILE_BYTES = "10485760"
