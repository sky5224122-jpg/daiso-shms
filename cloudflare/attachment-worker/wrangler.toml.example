name = "daiso-shms-attachments"
main = "src/index.js"
compatibility_date = "2026-08-13"

[[r2_buckets]]
binding = "SHMS_FILES"
bucket_name = "daiso-shms-files"

[[durable_objects.bindings]]
name = "SHMS_STORAGE_LIMITER"
class_name = "ShmsStorageLimiter"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["ShmsStorageLimiter"]

[vars]
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "sb_publishable_YOUR_PUBLIC_KEY"
APP_ORIGIN = "https://sky5224122-jpg.github.io"
MAX_FILE_BYTES = "15728640"
MAX_IMAGE_BYTES = "15728640"
TOTAL_STORAGE_LIMIT_BYTES = "3221225472"
STORAGE_WARNING_BYTES = "2899102924"
